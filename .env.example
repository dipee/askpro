# Askwell environment variables (docs/project.md §11).
# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values reach the browser — never put a secret in one.

# --- Phase 0 — Setup ---------------------------------------------------------
# No app variables.

# --- Phase 1 — Foundation ----------------------------------------------------
# Supabase (dev project for local + preview, prod project for production)
NEXT_PUBLIC_SUPABASE_URL=
# Public by design: RLS is the boundary
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only
CLERK_SECRET_KEY=

# --- Phase 2 — Projects + widget ---------------------------------------------
NEXT_PUBLIC_APP_URL=

# --- Phase 3 — Knowledge + chat ----------------------------------------------
# Server only
OPENAI_API_KEY=
# Server only
ARCJET_KEY=

# --- Phase 4 — Conversations + analytics -------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Phase 5 — Billing + customize -------------------------------------------
# Server only
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Phase 6 — Harden + launch -----------------------------------------------
# Server only, read at request time. A public key, but per-environment config.
LANDING_WIDGET_KEY=

# --- Tooling (not read by the app) -------------------------------------------
# Used by `pnpm db:types` only
SUPABASE_PROJECT_ID=
